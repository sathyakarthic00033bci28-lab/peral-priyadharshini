#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {

 int n;
    int sum = 0;

    // Read the size of the array
    if (scanf("%d", &n) != 1) {
        return 1;
    }

    // Allocate memory dynamically
    int *arr = (int*)malloc(n * sizeof(int));
    if (arr == NULL) {
        return 1; 
    }

    // Read values and compute sum
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    // Print the final sum
    printf("%d\n", sum);

    // Free the allocated memory
    free(arr);
  
    return 0;
}

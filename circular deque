#include <stdbool.h>
#include <stdlib.h>

typedef struct {
    int* data;
    int head;
    int tail;
    int capacity;
    int size;
} MyCircularDeque;

// Initializes the deque with a maximum size of k.
MyCircularDeque* myCircularDequeCreate(int k) {
    MyCircularDeque* obj = (MyCircularDeque*)malloc(sizeof(MyCircularDeque));
    obj->data = (int*)malloc(sizeof(int) * k);
    obj->head = 0;
    obj->tail = k - 1; // Set tail to k-1 so the first insertLast goes into index 0
    obj->capacity = k;
    obj->size = 0;
    return obj;
}

// Checks whether the circular deque is empty.
bool myCircularDequeIsEmpty(MyCircularDeque* obj) {
    return obj->size == 0;
}

// Checks whether the circular deque is full.
bool myCircularDequeIsFull(MyCircularDeque* obj) {
    return obj->size == obj->capacity;
}

// Adds an item at the front of Deque. Returns true if successful.
bool myCircularDequeInsertFront(MyCircularDeque* obj, int value) {
    if (myCircularDequeIsFull(obj)) {
        return false;
    }
    // Move head backward in a circular manner
    obj->head = (obj->head - 1 + obj->capacity) % obj->capacity;
    obj->data[obj->head] = value;
    obj->size++;
    return true;
}

// Adds an item at the rear of Deque. Returns true if successful.
bool myCircularDequeInsertLast(MyCircularDeque* obj, int value) {
    if (myCircularDequeIsFull(obj)) {
        return false;
    }
    // Move tail forward in a circular manner
    obj->tail = (obj->tail + 1) % obj->capacity;
    obj->data[obj->tail] = value;
    obj->size++;
    return true;
}

// Deletes an item from the front of Deque. Returns true if successful.
bool myCircularDequeDeleteFront(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return false;
    }
    // Move head forward in a circular manner
    obj->head = (obj->head + 1) % obj->capacity;
    obj->size--;
    return true;
}

// Deletes an item from the rear of Deque. Returns true if successful.
bool myCircularDequeDeleteLast(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return false;
    }
    // Move tail backward in a circular manner
    obj->tail = (obj->tail - 1 + obj->capacity) % obj->capacity;
    obj->size--;
    return true;
}

// Returns the front item from the Deque. Returns -1 if empty.
int myCircularDequeGetFront(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return -1;
    }
    return obj->data[obj->head];
}

// Returns the last item from the Deque. Returns -1 if empty.
int myCircularDequeGetRear(MyCircularDeque* obj) {
    if (myCircularDequeIsEmpty(obj)) {
        return -1;
    }
    return obj->data[obj->tail];
}

// Frees the allocated memory.
void myCircularDequeFree(MyCircularDeque* obj) {
    free(obj->data);
    free(obj);
}


